#!/usr/bin/env bash
# hulog CLI 本地包装脚本
#
# 用法:
#   bin/hulog <命令> [参数...]
#
# 特性:
#   - 所有命令行参数自动透传给 @hulog/cli（无需手动 node packages/cli/dist/index.js）
#   - dist 缺失或比 src 旧时自动重新构建，保证开发时改动即时生效
#   - 退出码与原命令一致，可直接用于脚本链

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CLI_SRC_DIR="$ROOT/packages/cli/src"
CLI_DIST="$ROOT/packages/cli/dist/index.js"

# dist 缺失，或 src 下有文件比 dist 新 → 需要重新构建
needs_build() {
  [[ ! -f "$CLI_DIST" ]] && return 0
  [[ -n "$(find "$CLI_SRC_DIR" -type f -newer "$CLI_DIST" -print -quit)" ]] && return 0
  return 1
}

if needs_build; then
  echo "hulog: @hulog/cli 未构建或有新改动，正在构建..." >&2
  (cd "$ROOT" && pnpm --filter @hulog/cli build)
fi

exec node "$CLI_DIST" "$@"

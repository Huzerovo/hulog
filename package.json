{
  "name": "hulog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "静态博客生成器——Hexo 内容模型 + Astro 式 TSX 主题",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:core && npm run build:cli",
    "build:core": "npm run build --workspace=@hulog/core",
    "build:cli": "npm run build --workspace=@hulog/cli",
    "typecheck": "npm run typecheck --workspaces",
    "typecheck:core": "npm run typecheck --workspace=@hulog/core",
    "typecheck:cli": "npm run typecheck --workspace=@hulog/cli",
    "clean": "npm run clean --workspaces",
    "clean:core": "npm run clean --workspace=@hulog/core",
    "clean:cli": "npm run clean --workspace=@hulog/cli",
    "test": "npm run test:core",
    "test:core": "npm run test --workspace=@hulog/core",
    "server": "node packages/cli/dist/index.js dev -b examples"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}

{
  "name": "@hulog/core",
  "version": "0.1.6",
  "type": "module",
  "description": "生成器核心：内容模型、构建管线、插件系统、主题加载、单文件渲染",
  "keywords": [
    "hulog",
    "static-site-generator",
    "blog",
    "markdown",
    "preact"
  ],
  "author": "Huzerovo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Huzerovo/hulog.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Huzerovo/hulog/tree/master/packages/core#readme",
  "bugs": {
    "url": "https://github.com/Huzerovo/hulog/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "node --import tsx --test test/*.test.ts",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "dev": "tsc -p tsconfig.json --watch",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@shikijs/rehype": "^4.4.2",
    "@shikijs/themes": "^4.4.2",
    "@tuyuritio/rehype-table-wrapper": "^1.0.1",
    "cosmiconfig": "^10.0.0",
    "esbuild": "^0.28.1",
    "gray-matter": "^4.0.3",
    "hast-util-to-string": "^3.0.1",
    "jiti": "^2.7.0",
    "less": "^4.8.1",
    "preact": "^10.29.8",
    "preact-render-to-string": "^6.7.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.4.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "peerDependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/hast": "^3.0.5",
    "@types/less": "^3.0.8",
    "@types/node": "^26.1.2",
    "zod": "^4.4.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
